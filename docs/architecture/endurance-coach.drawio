  <diagram id="07-dettagli-canonici" name="Dettagli della seduta: dati e layer">
    <mxGraphModel dx="1400" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Dettagli della seduta: dati e layer&lt;br&gt;&lt;font size='3'&gt;Dati normalizzati e owner-bound; nessuna connessione cloud vendor approvata. HealthKit: dettagli selezionati; test device da completare.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;Fonte / adapter autorizzato&lt;/b&gt;&lt;br&gt;Garmin locale: normalizer senza rete&lt;br&gt;Altri client: dati importati&lt;br&gt;Unità vendor convertite prima dell&amp;#x27;API" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="140" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;SessionDetails canonico&lt;/b&gt;&lt;br&gt;Lap, campioni e segmenti GPS&lt;br&gt;Metri / secondi / bpm / watt&lt;br&gt;Indici di step senza marker repeat FIT&lt;br&gt;Dati incompleti restano espliciti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f3effb;strokeColor=#8063aa;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="515" y="140" width="365" height="175" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API dettagli per atleta e fonte&lt;/b&gt;&lt;br&gt;GET/PUT /v1/activities/{source}/{id}/details&lt;br&gt;Bearer; versioni e hash del riepilogo&lt;br&gt;Rifiuta tempi/distanze incoerenti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;Riferimento al piano storico&lt;/b&gt;&lt;br&gt;PlanVersion + workout dichiarato&lt;br&gt;Solo versioni dello stesso atleta&lt;br&gt;Cambio piano conserva i target passati" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="455" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;Analisi comune delle fasi&lt;/b&gt;&lt;br&gt;evaluate_measured_session&lt;br&gt;Ordine, durata, passo e FC dei lap&lt;br&gt;Metriche e limiti; nessuna chiamata AI" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f3effb;strokeColor=#8063aa;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="515" y="455" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Storage separato&lt;/b&gt;&lt;br&gt;ac_activities: riepiloghi leggeri&lt;br&gt;ac_activity_details: dati per fonte&lt;br&gt;FK owner/fonte/ID; cascade delete&lt;br&gt;Hash cambiato: dettagli obsoleti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1000" y="455" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;Review personale Garmin&lt;/b&gt;&lt;br&gt;Parser Garmin + analisi comune&lt;br&gt;Target dal piano locale corrente&lt;br&gt;Originale remoto non verificato" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="805" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ios" value="&lt;b&gt;Review nativa SwiftUI&lt;/b&gt;&lt;br&gt;Fasi, lap e dinamiche&lt;br&gt;Grafici FC/passo in unità separate&lt;br&gt;MapKit: segmenti GPS distinti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="515" y="805" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="gates" value="&lt;b&gt;Integrazioni da completare&lt;/b&gt;&lt;br&gt;Accessi vendor approvati&lt;br&gt;HealthKit: test device/permessi&lt;br&gt;AI remoto e release firmata" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="805" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="normalizza" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="source" target="contract">
