  <diagram id="08-redis-proposto" name="Redis e job: proposta per il servizio scalabile">
    <mxGraphModel dx="1400" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1070">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Redis e job: proposta per il servizio scalabile&lt;br&gt;&lt;font size='3'&gt;Architettura futura: Redis, dispatcher e worker vendor non sono implementati. PostgreSQL resta la fonte autorevole.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API della piattaforma&lt;/b&gt;&lt;br&gt;Richieste utenti e webhook futuri&lt;br&gt;Autenticazione e owner dell&amp;#x27;atleta&lt;br&gt;Accoda lavori; risponde rapidamente" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="140" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Piani, attività e audit già presenti&lt;br&gt;Job/outbox: da implementare&lt;br&gt;Stato e idempotenza persistenti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis: broker e cache&lt;/b&gt;&lt;br&gt;Coda worker; nessun token in chiaro&lt;br&gt;Cache review con owner/hash e TTL&lt;br&gt;Persistenza/eviction da configurare" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="dispatcher" value="&lt;b&gt;Dispatcher dell&amp;#x27;outbox&lt;/b&gt;&lt;br&gt;Pubblica job committati nel DB&lt;br&gt;Recupera consegne interrotte&lt;br&gt;Invia ID, non dati sanitari" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="455" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker separati&lt;/b&gt;&lt;br&gt;Refresh e backfill&lt;br&gt;Retry/backoff e quote per vendor&lt;br&gt;Idempotenza; stato aggiornato in SQL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="805" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="vendors" value="&lt;b&gt;API vendor approvate&lt;/b&gt;&lt;br&gt;Garmin / COROS / Suunto / altri&lt;br&gt;Token per atleta gestiti dal server&lt;br&gt;Adapter → ActivityRecord/SessionDetails" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="805" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="results" value="&lt;b&gt;Review e stato del lavoro&lt;/b&gt;&lt;br&gt;Dati definitivi nel database&lt;br&gt;Notifiche e aggiornamenti del client&lt;br&gt;Cache ricostruibile dopo perdita Redis" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="805" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="dati + job in transazione" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="api" target="postgres">
