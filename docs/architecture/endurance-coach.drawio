        <mxCell id="edge-3" value="lettura coerente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="db" target="engine">
