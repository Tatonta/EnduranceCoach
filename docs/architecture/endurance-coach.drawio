<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="EnduranceCoach architecture generator" version="24.7.17" type="device" compressed="false">
  <diagram id="01-sistema-attuale" name="Sistema attuale: due percorsi separati">
    <mxGraphModel dx="1260" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1090">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Sistema attuale: due percorsi separati&lt;br&gt;&lt;font size='3'&gt;Frecce = chiamate; verde/blu/viola = codice presente; tratteggio = parte futura. Nessun hosting pubblico.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="health" value="&lt;b&gt;Apple Health sul telefono&lt;/b&gt;&lt;br&gt;SDK HealthKit • sola lettura&lt;br&gt;Dati effettivamente disponibili e autorizzati" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ios" value="&lt;b&gt;App iPhone · SwiftUI&lt;/b&gt;&lt;br&gt;Review / Consigli / Piano / Account&lt;br&gt;CoachStore + APIClient + SessionVault&lt;br&gt;HealthImporter: anteprima + consenso invio" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Browser locale + CLI&lt;/b&gt;&lt;br&gt;HTML/Jinja2 + JavaScript&lt;br&gt;app/templates, app/static, app/cli.py&lt;br&gt;Questa UI NON usa il backend /v1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="825" y="270" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="platform" value="&lt;b&gt;Backend multi-atleta&lt;/b&gt;&lt;br&gt;FastAPI · app/platform/main.py&lt;br&gt;API /v1/* · autenticazione Bearer&lt;br&gt;AccountService / AthleteService&lt;br&gt;Nessuna connessione diretta ai vendor" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;App Garmin personale&lt;/b&gt;&lt;br&gt;FastAPI · app/main.py · API /api/*&lt;br&gt;Coach: review, refresh, sync, cleanup&lt;br&gt;APScheduler + lock su file&lt;br&gt;Uso locale mono-atleta, senza login web" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="825" y="500" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;Regole condivise&lt;/b&gt;&lt;br&gt;models.py + ActivityRecord&lt;br&gt;reviewer.py&lt;br&gt;workout_review.py&lt;br&gt;Regole deterministiche; nessun LLM&lt;br&gt;È una libreria, non un terzo server" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f3effb;strokeColor=#8063aa;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="475" y="500" width="285" height="210" as="geometry" />
        </mxCell>
        <mxCell id="platformdb" value="&lt;b&gt;Archivio della piattaforma&lt;/b&gt;&lt;br&gt;PlatformStore → SQLAlchemy&lt;br&gt;PostgreSQL per hosting; SQLite nei test&lt;br&gt;Account, piani versionati, attività&lt;br&gt;Proposte, sessioni e audit per atleta" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="775" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="localdb" value="&lt;b&gt;Archivio personale separato&lt;/b&gt;&lt;br&gt;data/coach.sqlite3 + workouts.json&lt;br&gt;Cache, snapshot e prove di sync&lt;br&gt;Sessioni Garmin fuori dal repository&lt;br&gt;Non viene importato nella piattaforma" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="825" y="775" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="future" value="&lt;b&gt;Integrazioni ancora da implementare&lt;/b&gt;&lt;br&gt;COROS · Suunto · Fitbit/Google Health · Amazfit · Xiaomi&lt;br&gt;OAuth approvato, token cifrati, worker/webhook, export workout&lt;br&gt;Apple Health è un ponte locale, non un&amp;#x27;API diretta del vendor" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="980" width="690" height="110" as="geometry" />
        </mxCell>
        <mxCell id="garmin" value="&lt;b&gt;Garmin Connect personale&lt;/b&gt;&lt;br&gt;GarminClient / python-garminconnect&lt;br&gt;Lettura attività + upload/schedule locali" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="825" y="980" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="SDK locale" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="health" target="ios">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="HTTPS · JSON · Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="ios" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="HTTP localhost:8000 / chiamate CLI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="web" target="local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="Python" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="platform" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="Python" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="local" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="SQL/ORM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="platform" target="platformdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="SQL + file locali" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="local" target="localdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="HTTPS cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="local" target="garmin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="580" />
              <mxPoint x="1200" y="1025" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="02-layer-backend" name="Layer del backend multi-atleta">
    <mxGraphModel dx="1400" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1070">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Layer del backend multi-atleta&lt;br&gt;&lt;font size='3'&gt;Confini logici nello stesso processo Python. L&amp;#x27;HTTP separa app iPhone e backend; i servizi dipendono ancora dall&amp;#x27;ORM.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Presentazione e stato iOS&lt;/b&gt;&lt;br&gt;SwiftUI Views → CoachStore&lt;br&gt;Nessuna decisione autonoma sul piano&lt;br&gt;Il bottone segue program.eligible" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="370" height="135" as="geometry" />
        </mxCell>
        <mxCell id="httpclient" value="&lt;b&gt;Trasporto iOS&lt;/b&gt;&lt;br&gt;APIClient · URLSession ephemeral&lt;br&gt;DTO Swift + encoding/decoding JSON&lt;br&gt;HTTPS; redirect respinti" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#edf3ff;strokeColor=#5972ae;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="130" width="345" height="135" as="geometry" />
        </mxCell>
        <mxCell id="vault" value="&lt;b&gt;Sessione sul dispositivo&lt;/b&gt;&lt;br&gt;SessionVault → Keychain&lt;br&gt;Token opaco legato a account/origine&lt;br&gt;Password non persistita" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="130" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API e identità&lt;/b&gt;&lt;br&gt;app/platform/main.py&lt;br&gt;FastAPI routes + middleware&lt;br&gt;HTTPBearer → identity()&lt;br&gt;Owner determinato dal server" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="375" width="345" height="170" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="&lt;b&gt;Contratti di ingresso&lt;/b&gt;&lt;br&gt;platform/schemas.py · Pydantic&lt;br&gt;PlanWrite / ActivityImport&lt;br&gt;ProposalAcceptance / AccountDeletion&lt;br&gt;StrictModel: rifiuta campi extra" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f3effb;strokeColor=#8063aa;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="375" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="accounts" value="&lt;b&gt;Servizio account&lt;/b&gt;&lt;br&gt;AccountService · security.py&lt;br&gt;Register/login/logout/delete&lt;br&gt;Argon2id + digest sessioni + rate limit&lt;br&gt;Query SQLAlchemy dirette" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="athletes" value="&lt;b&gt;Servizio atleta&lt;/b&gt;&lt;br&gt;AthleteService · service.py&lt;br&gt;Piano, import, dedup, review, proposal&lt;br&gt;Scope atleta + versioni + audit&lt;br&gt;Query SQLAlchemy dirette" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#eff8f7;strokeColor=#497d76;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="640" width="345" height="155" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Dominio condiviso&lt;/b&gt;&lt;br&gt;Plan / Workout / Step / ActivityRecord&lt;br&gt;review_latest_workouts()&lt;br&gt;last_workout_review()&lt;br&gt;adjusted_plan()&lt;br&gt;Nessun LLM, DB o vendor" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f3effb;strokeColor=#8063aa;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="625" width="310" height="185" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;Persistenza e transazioni&lt;/b&gt;&lt;br&gt;PlatformStore · store.py&lt;br&gt;transaction() / read_session()&lt;br&gt;lock_athlete() · pool e timeout&lt;br&gt;Non è ancora un repository astratto" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="905" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="tables" value="&lt;b&gt;Schema SQL&lt;/b&gt;&lt;br&gt;tables.py → 8 tabelle ac_*&lt;br&gt;FK/cascade, indici e chiavi composte&lt;br&gt;PostgreSQL / SQLite&lt;br&gt;Autorizzazione applicativa, non RLS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#f1f6e9;strokeColor=#718544;fontColor=#17212f;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="905" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="coupling" value="&lt;b&gt;Punto di refactoring&lt;/b&gt;&lt;br&gt;I servizi conoscono Session e tabelle.&lt;br&gt;Estrarre repository/UnitOfWork rende&lt;br&gt;il dominio e i casi d&amp;#x27;uso più isolati." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fontSize=15;fillColor=#fff5e5;strokeColor=#a77d35;fontColor=#17212f;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="905" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="metodi Swift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="ui" target="httpclient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="read/write sessione" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="ui" target="vault">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="255" y="110" />
              <mxPoint x="1175" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="HTTP JSON /v1/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="httpclient" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="valida body" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="api" target="schema">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="auth + identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#526071;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="api" target="accounts">
          <mxGeometry relative="1" as="geometry">
