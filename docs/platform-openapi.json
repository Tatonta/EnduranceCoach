  "components": {
    "schemas": {
      "AccountDeletion": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AccountDeletion"
      },
      "ActivityImport": {
        "properties": {
          "ingestion_method": {
            "type": "string",
            "const": "client_import",
            "title": "Ingestion Method",
            "default": "client_import"
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/ActivityRecord"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Activities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activities"
        ],
        "title": "ActivityImport"
      },
      "ActivityRecord": {
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "title": "Source"
          },
          "source_activity_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Activity Id"
          },
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Name"
          },
          "sport": {
            "type": "string",
            "pattern": "^(running|cycling|strength|other)$",
            "title": "Sport"
          },
          "activity_type": {
            "type": "string",
            "title": "Activity Type"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "distance_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance M"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Duration S"
          },
          "elapsed_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Elapsed Duration S"
          },
          "avg_pace_s_km": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Pace S Km"
          },
          "avg_hr": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 250.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Hr"
          },
          "max_hr": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 250.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Hr"
          },
          "elevation_gain_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Elevation Gain M"
          },
          "training_load": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Training Load"
          },
          "aerobic_training_effect": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Aerobic Training Effect"
          },
          "workout_id": {
            "type": "string",
            "title": "Workout Id",
            "default": ""
          },
          "feedback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionFeedback"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "source_activity_id",
          "name",
          "sport",
          "activity_type",
          "start_time",
          "distance_m",
          "duration_s",
          "elapsed_duration_s"
        ],
        "title": "ActivityRecord",
        "description": "Canonical SI-unit activity, independent of any vendor's response schema."
      },
      "BestPerformance": {
        "properties": {
          "sport": {
            "type": "string",
            "enum": [
              "running",
              "cycling"
            ],
            "title": "Sport"
          },
          "distance_m": {
            "type": "number",
            "maximum": 500000.0,
            "minimum": 400.0,
            "title": "Distance M"
          },
          "duration_s": {
            "type": "number",
            "maximum": 172800.0,
            "minimum": 30.0,
            "title": "Duration S"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sport",
          "distance_m",
          "duration_s"
        ],
        "title": "BestPerformance"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HRTarget": {
        "properties": {
          "type": {
            "type": "string",
            "const": "hr_zone",
            "title": "Type"
          },
          "zone": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Zone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "zone"
        ],
        "title": "HRTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualSession": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Request Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "sport": {
            "type": "string",
            "enum": [
              "running",
              "cycling",
              "strength",
              "other"
            ],
            "title": "Sport"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "duration_min": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Duration Min"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1500.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "perceived_exertion": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Perceived Exertion"
          },
          "feeling": {
            "type": "string",
            "enum": [
              "good",
              "normal",
              "fatigued",
              "very_fatigued"
            ],
            "title": "Feeling",
            "default": "normal"
          },
          "discomfort": {
            "type": "string",
            "enum": [
              "none",
              "present",
              "prefer_not_to_say"
            ],
            "title": "Discomfort",
            "default": "prefer_not_to_say"
          },
          "completed_as_planned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed As Planned"
          },
          "notes": {
            "type": "string",
            "maxLength": 1500,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "name",
          "sport",
          "start_time",
          "duration_min"
        ],
        "title": "ManualSession"
      },
      "PaceTarget": {
        "properties": {
          "type": {
            "type": "string",
            "const": "pace",
            "title": "Type"
          },
          "slow": {
            "type": "string",
            "title": "Slow"
          },
          "fast": {
            "type": "string",
            "title": "Fast"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "slow",
          "fast"
        ],
        "title": "PaceTarget"
      },
      "Plan": {
        "properties": {
          "plan_name": {
            "type": "string",
            "minLength": 1,
            "title": "Plan Name"
          },
          "goal": {
            "type": "string",
            "title": "Goal",
            "default": ""
          },
          "athlete": {
